變數 JSON = 匯入("Serialization");
變數 核心 = 0;
變數 世界ID = 0;
變數 Initialize = 函式(library, id) { 核心 = library; 世界ID = id; };
變數 Request = 函式(method, args) { 回傳 JSON.ParseJson(核心.Dispatch( JSON.Json([世界ID, method, args]))); };
變數 釋放, Dispose = 函式() { 回傳 Request("Dispose", []); };
變數 建立球體, CreateSphere = 函式(a0, a1, a2) { 回傳 Request("CreateSphere", [a0, a1, a2]); };
變數 建立方塊, CreateBox = 函式(a0, a1, a2) { 回傳 Request("CreateBox", [a0, a1, a2]); };
變數 步進, Step = 函式(a0, a1) { 回傳 Request("Step", [a0, a1]); };
變數 取得物體數量, GetBodyCount = 函式() { 回傳 Request("GetBodyCount", []); };
變數 取得重力, GetGravity = 函式() { 回傳 Request("GetGravity", []); };
變數 設定重力, SetGravity = 函式(a0) { 回傳 Request("SetGravity", [a0]); };
變數 取得位置, GetPosition = 函式(a0) { 回傳 Request("GetPosition", [a0]); };
變數 取得旋轉, GetRotation = 函式(a0) { 回傳 Request("GetRotation", [a0]); };
變數 取得線速度, GetLinearVelocity = 函式(a0) { 回傳 Request("GetLinearVelocity", [a0]); };
變數 取得角速度, GetAngularVelocity = 函式(a0) { 回傳 Request("GetAngularVelocity", [a0]); };
變數 設定位置, SetPosition = 函式(a0, a1) { 回傳 Request("SetPosition", [a0, a1]); };
變數 設定旋轉, SetRotation = 函式(a0, a1) { 回傳 Request("SetRotation", [a0, a1]); };
變數 設定線速度, SetLinearVelocity = 函式(a0, a1) { 回傳 Request("SetLinearVelocity", [a0, a1]); };
變數 設定角速度, SetAngularVelocity = 函式(a0, a1) { 回傳 Request("SetAngularVelocity", [a0, a1]); };
變數 加入力, AddForce = 函式(a0, a1) { 回傳 Request("AddForce", [a0, a1]); };
變數 加入衝量, AddImpulse = 函式(a0, a1) { 回傳 Request("AddImpulse", [a0, a1]); };
變數 加入角衝量, AddAngularImpulse = 函式(a0, a1) { 回傳 Request("AddAngularImpulse", [a0, a1]); };
變數 設定摩擦力, SetFriction = 函式(a0, a1) { 回傳 Request("SetFriction", [a0, a1]); };
變數 設定恢復係數, SetRestitution = 函式(a0, a1) { 回傳 Request("SetRestitution", [a0, a1]); };
變數 是否作用中, IsActive = 函式(a0) { 回傳 Request("IsActive", [a0]); };
變數 移除物體, RemoveBody = 函式(a0) { 回傳 Request("RemoveBody", [a0]); };
變數 最佳化廣域碰撞, OptimizeBroadPhase = 函式() { 回傳 Request("OptimizeBroadPhase", []); };
